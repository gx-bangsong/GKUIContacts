<!-- Horizontally scrolling row of group (label) chips, shown between the search bar and the
     contact list. Starts GONE; GroupChipsController makes it visible once groups have loaded,
     and hides it again when there are none. -->
<HorizontalScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_chips_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/group_chips_bar_horizontal_padding"
    android:paddingEnd="@dimen/group_chips_bar_horizontal_padding"
    android:paddingTop="@dimen/group_chips_bar_vertical_padding"
    android:paddingBottom="@dimen/group_chips_bar_vertical_padding"
    android:scrollbars="none"
    android:visibility="gone">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/group_chips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Contacts.GroupChips"
        app:chipSpacingHorizontal="@dimen/group_chip_spacing"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</HorizontalScrollView>
