<!-- Chip fill. The checked state plays the role of MD3 secondaryContainer; because the app
     theme is AppCompat rather than Material 3, the tone is taken from the platform's dynamic
     colour palette directly instead of via ?attr/colorSecondaryContainer. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/group_chip_container_selected" android:state_checked="true" />
    <item android:color="@color/group_chip_container_unselected" />
</selector>
