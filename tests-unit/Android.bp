package {
    // See: http://go/android-license-faq
    default_applicable_licenses: [
        "packages_apps_Contacts_license",
        "Android-Apache-2.0",
    ],
}

// Host-side JVM unit tests for the pure-Java parts of the Contacts app.
//
// These deliberately contain no Android dependency, so they run in milliseconds on the host
// instead of needing a device/emulator like the instrumentation module in tests/.
//
//   atest ContactsSurnameUnitTests
//
// The sources under test come from the app tree via the :contacts-pure-java-srcs filegroup,
// which is declared in the top-level Android.bp (Soong does not allow ".." in srcs).
java_test_host {
    name: "ContactsSurnameUnitTests",

    srcs: [
        ":contacts-pure-java-srcs",
        "src/**/*.java",
    ],

    static_libs: [
        "junit",
    ],

    test_suites: ["general-tests"],

    test_options: {
        unit_test: true,
    },
}
